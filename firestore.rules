rules_version = '2';
// Only "who has drawn" is stored: draws/<random draw id>/claims/<person number> = { at: <time> }.
// No names, no results. Anyone with the page can read the list, claim an unclaimed number once,
// or remove a claim (the organiser's "Reset" button).
service cloud.firestore {
  match /databases/{database}/documents {
    match /draws/{drawId}/claims/{personId} {
      allow read, delete: if drawId.matches('^[a-z0-9]{4,24}$');
      allow create: if drawId.matches('^[a-z0-9]{4,24}$')
        && personId.matches('^[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is int;
      allow update: if false;
    }
  }
}
